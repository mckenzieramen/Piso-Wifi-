rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'bigguy@admin.com';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'admin';
    }

    // Scalable central collections: one record per document, avoiding the 1 MiB
    // aggregate-document limit and allowing many employees/attendance/sales records.
    match /bigguys_employees/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /bigguys_faces/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /bigguys_attendance/{id} {
      allow read, write: if signedIn();
    }
    match /bigguys_sales/{id} {
      allow read: if admin();
      allow write: if admin();
    }
    match /bigguys_reports/{id} {
      allow read, write: if admin();
    }
    match /bigguys_meta/{id} {
      allow read: if signedIn();
      allow write: if admin() || (signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous' && id == 'attendance');
    }

    // Legacy documents retained for compatibility with existing data.
    match /bigguys/{docId} {
      allow read: if (signedIn() && (docId == 'public' || docId == 'attendance')) || admin();
      allow write: if admin() || (signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous' && docId == 'attendance');
    }
  }
}
