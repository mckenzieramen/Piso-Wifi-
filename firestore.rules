rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userData() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }
    function isAdmin() { return signedIn() && userData().role == "admin" && userData().active != false; }
    function isClient() { return signedIn() && userData().role == "client" && userData().active != false; }
    function ownsUnit(data) {
      return isClient() && ((data.authUserId != null && data.authUserId == request.auth.uid) ||
        (data.email != null && data.email != "" && request.auth.token.email != null && data.email == request.auth.token.email));
    }
    function ownsUnitId(unitId) {
      return exists(/databases/$(database)/documents/units/$(unitId)) && ownsUnit(get(/databases/$(database)/documents/units/$(unitId)).data);
    }
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /units/{unitId} {
      allow read: if isAdmin() || ownsUnit(resource.data);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (ownsUnit(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","contact","address","authUserId","forcePasswordChange","passwordChangedAt","updatedAt"]));
    }
    match /monthlyRecords/{id} { allow read: if isAdmin() || (signedIn() && ownsUnitId(resource.data.unitId)); allow write: if isAdmin(); }
    match /payments/{id} { allow read: if isAdmin() || (signedIn() && ownsUnitId(resource.data.unitId)); allow write: if isAdmin(); }
    match /settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.relatedId != null && ownsUnitId(resource.data.relatedId));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.relatedId != null && ownsUnitId(resource.data.relatedId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]));
    }
    match /activities/{id} { allow read, write: if isAdmin(); }
  }
}
