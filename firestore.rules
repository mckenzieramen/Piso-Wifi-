rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "u3Vjej0CrFgDSekt3NpXuHERpJM2";
    }

    function isClientUnit(data) {
      return isSignedIn()
        && (
          (data.authUserId != null && data.authUserId == request.auth.uid)
          || (data.email != null
              && data.email != ""
              && data.email == request.auth.token.email)
        );
    }

    function isOwnUnitDocument(unitId) {
      return exists(/databases/$(database)/documents/units/$(unitId))
        && isClientUnit(get(/databases/$(database)/documents/units/$(unitId)).data);
    }

    match /users/{uid} {
      // Admin can manage role records; a signed-in user may read only their own role.
      allow read: if isAdmin() || (isSignedIn() && uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["sessionId", "sessionUpdatedAt"]));
    }

    match /units/{document} {
      allow read: if isAdmin() || isClientUnit(resource.data);

      // Admin owns all client/unit administration.
      allow create, delete: if isAdmin();

      // Clients may update only their own profile fields or establish the UID link.
      allow update: if isAdmin()
        || (
          isClientUnit(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["name", "contact", "address", "authUserId", "forcePasswordChange", "passwordChangedAt", "updatedAt"])
        );
    }

    match /monthlyRecords/{document} {
      allow read: if isAdmin() || isOwnUnitDocument(resource.data.unitId);
      allow write: if isAdmin();
    }

    match /payments/{document} {
      allow read: if isAdmin() || isOwnUnitDocument(resource.data.unitId);
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{document} {
      allow read: if isAdmin() || (
        resource.data.relatedId != null
        && isOwnUnitDocument(resource.data.relatedId)
      );

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          resource.data.relatedId != null
          && isOwnUnitDocument(resource.data.relatedId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        );
    }

    match /activities/{document} {
      allow read, write: if isAdmin();
    }
  }
}
