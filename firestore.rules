
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.email == "pisonet@admin.com"
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("active", true) == true
          )
        );
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isCashier() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userDoc().data.role == "cashier"
        && userDoc().data.get("active", true) == true;
    }

    function isClientUnit(data) {
      return isSignedIn()
        && (
          (data.authUserId != null
            && data.authUserId == request.auth.uid)
          || (
            data.email != null
            && data.email != ""
            && data.email == request.auth.token.email
          )
        );
    }

    function isOwnUnitDocument(unitId) {
      return exists(
          /databases/$(database)/documents/units/$(unitId)
        )
        && isClientUnit(
          get(/databases/$(database)/documents/units/$(unitId)).data
        );
    }

    // USERS
    match /users/{uid} {
      allow read: if isAdmin()
        || (isSignedIn() && uid == request.auth.uid);

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isSignedIn()
          && uid == request.auth.uid
          && resource.data.role == "cashier"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["forcePasswordChange", "passwordChangedAt"])
        );
    }

    // CLIENT UNITS
    match /units/{document} {
      allow read: if isAdmin()
        || isCashier()
        || isClientUnit(resource.data);

      allow create: if isAdmin()
        || (
          request.resource.data.type == "password-reset"
          && request.resource.data.read == false
          && request.resource.data.title == "Customer password reset requested"
          && request.resource.data.clientCode is string
          && request.resource.data.unitCode is string
          && request.resource.data.email is string
          && exists(
            /databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)
          )
          && get(
            /databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)
          ).data.unitCode == request.resource.data.unitCode
          && get(
            /databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)
          ).data.email == request.resource.data.email
          && get(
            /databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)
          ).data.active == true
        );

      allow delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isClientUnit(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "name",
              "contact",
              "address",
              "authUserId",
              "forcePasswordChange",
              "passwordChangedAt",
              "updatedAt"
            ])
        );
    }

    // MONTHLY RECORDS
    match /monthlyRecords/{document} {
      allow read: if isAdmin()
        || isOwnUnitDocument(resource.data.unitId);

      allow write: if isAdmin();
    }

    // PAYMENTS
    match /payments/{document} {
      allow read: if isAdmin()
        || isOwnUnitDocument(resource.data.unitId);

      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{document} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }

    // CUSTOMER LOGIN DIRECTORY
    match /customerLoginDirectory/{clientCode} {
      allow read, write: if isAdmin();
    }

    // PASSWORD RESET REQUESTS
    match /passwordResetRequests/{requestId} {
      allow create: if request.resource.data.status == "email_sent"
        && request.resource.data.adminRead == false
        && request.resource.data.clientCode is string
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)
        )
        && get(
          /databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)
        ).data.email == request.resource.data.email
        && get(
          /databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)
        ).data.active == true;

      allow read, update, delete: if isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{document} {
      allow read: if isAdmin()
        || (
          resource.data.relatedId != null
          && isOwnUnitDocument(resource.data.relatedId)
        );

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          resource.data.relatedId != null
          && isOwnUnitDocument(resource.data.relatedId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["read"])
        );
    }

    // SUPPORT CHATS — customer starts the ticket; cashier handles first; admin takes over after transfer.
    match /supportChats/{chatId} {
      // Customers can only read their own tickets. Cashiers can read unassigned
      // cashier tickets and tickets assigned to their own UID. Admin can read all.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.authUserId == request.auth.uid)
        || (isCashier()
          && resource.data.assignedRole == "cashier"
          && (resource.data.assignedCashierId == ""
            || resource.data.assignedCashierId == request.auth.uid));

      // A customer can create a ticket only for their own authenticated UID.
      allow create: if isAdmin()
        || (isSignedIn()
          && request.resource.data.authUserId == request.auth.uid
          && request.resource.data.status is string
          && request.resource.data.messages is list
          && request.resource.data.assignedRole == "cashier"
          && request.resource.data.assignedCashierId == "");

      // Cashier may claim/reply to an unassigned ticket or their own ticket.
      // They may transfer that same ticket to Admin, but cannot change ownership
      // to another cashier or edit customer identity fields.
      allow update: if isAdmin()
        || (isCashier()
          && resource.data.assignedRole == "cashier"
          && (resource.data.assignedCashierId == ""
            || resource.data.assignedCashierId == request.auth.uid)
          && request.resource.data.authUserId == resource.data.authUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "messages", "updatedAt", "typingBy", "unreadForCashier",
            "unreadForCustomer", "lastMessage", "lastMessageSender", "lastMessageAt",
            "status", "assignedRole", "assignedCashierId", "assignedCashierName",
            "transferredToAdmin", "transferredAt", "transferredBy", "transferredByName",
            "unreadForAdmin"
          ])
          && (
            (request.resource.data.assignedRole == "cashier"
              && request.resource.data.assignedCashierId == request.auth.uid)
            || (request.resource.data.assignedRole == "admin"
              && request.resource.data.transferredToAdmin == true
              && request.resource.data.transferredBy == request.auth.uid)
          ))
        // Customer may append messages and update customer-facing read/typing state only.
        || (isSignedIn()
          && resource.data.authUserId == request.auth.uid
          && request.resource.data.authUserId == resource.data.authUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "messages", "updatedAt", "typingBy", "unreadForAdmin",
            "unreadForCashier", "unreadForCustomer", "lastMessage",
            "lastMessageSender", "lastMessageAt", "status", "reopenedAt"
          ]));

      allow delete: if isAdmin();

      // INDIVIDUAL SUPPORT MESSAGES
      // Store each message in supportChats/{chatId}/messages/{messageId}
      // so long conversations do not exceed Firestore's 1 MiB document limit.
      match /messages/{messageId} {
        function supportChat() {
          return get(/databases/$(database)/documents/supportChats/$(chatId)).data;
        }

        allow read: if isAdmin()
          || (isSignedIn() && supportChat().authUserId == request.auth.uid)
          || (isCashier()
            && supportChat().assignedRole == "cashier"
            && (
              supportChat().assignedCashierId == ""
              || supportChat().assignedCashierId == request.auth.uid
            ));

        allow create: if isAdmin()
          || (
            isSignedIn()
            && supportChat().authUserId == request.auth.uid
            && request.resource.data.senderType == "customer"
            && request.resource.data.text is string
          )
          || (
            isCashier()
            && supportChat().assignedRole == "cashier"
            && (
              supportChat().assignedCashierId == ""
              || supportChat().assignedCashierId == request.auth.uid
            )
            && request.resource.data.senderType in ["cashier", "system"]
            && request.resource.data.text is string
          );

        // Messages are append-only for customers and cashiers.
        // Admin can moderate/delete if needed.
        allow update, delete: if isAdmin();
      }
    }

    // ACTIVITIES
    match /activities/{document} {
      allow read, write: if isAdmin();
    }

    // WIFI SUBSCRIPTIONS
    match /wifiSubscriptions/{subscriptionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // CASHIER SALES
    match /cashierTransactions/{id} {
      // Customers may read transactions for their own authenticated unit only.
      // Customer writes remain forbidden by the create/update/delete rules below.
      allow read: if isAdmin()
        || (isSignedIn()
          && resource.data.unitId is string
          && isOwnUnitDocument(resource.data.unitId))
        || (
          isCashier()
          && resource.data.cashierId == request.auth.uid
        );

      allow create: if isCashier()
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.status == "AWAITING CUSTOMER EARNINGS PAYMENT"
        && request.resource.data.grossSales is number
        && request.resource.data.grossSales > 0
        && request.resource.data.customerId is string
        && request.resource.data.unitId is string;

      allow update: if isAdmin()
        || (
          isCashier()
          && resource.data.cashierId == request.auth.uid
          && resource.data.status != "CUSTOMER EARNINGS PAID"
          && request.resource.data.cashierId == resource.data.cashierId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "status",
              "customerEarningsPaid",
              "customerEarningsPaidAt",
              "customerEarningsPaidBy",
              "customerEarningsAcknowledgedBy",
              "customerEarningsAcknowledgedAt",
              "receiptId",
              "receiptSummary",
              "dashboardPaymentSyncStatus",
              "receiptEmailStatus",
              "receiptEmailSentAt",
              "receiptEmailError",
              "receiptEmailAttemptedAt"
            ])
          && request.resource.data.status == "CUSTOMER EARNINGS PAID"
          && request.resource.data.customerEarningsPaid == true
          && request.resource.data.customerEarningsPaidBy == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // RECEIPTS
    match /receipts/{id} {
      allow read: if isAdmin()
        || (
          isCashier()
          && resource.data.cashierId == request.auth.uid
        );

      // Admins may create a receipt from the admin workflow.
      // Cashiers may create receipts only for their own authenticated UID.
      allow create: if isAdmin()
        || (
          isCashier()
          && request.resource.data.cashierId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // CUSTOMER CHATS
    match /customerChats/{id} {
      allow read: if isAdmin()
        || (
          isCashier()
          && resource.data.cashierId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          isCashier()
          && request.resource.data.cashierId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          isCashier()
          && resource.data.cashierId == request.auth.uid
          && resource.data.status != "TRANSFERRED TO ADMIN"
          && request.resource.data.cashierId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // CHAT MESSAGES
    match /chat_messages/{id} {
      allow read, write: if isAdmin();
    }

    // WIFI PLANS
    match /wifi_plans/{id} {
      allow read: if isAdmin()
        || (
          isCashier()
          && resource.data.status == "ACTIVE"
        );

      allow create, update, delete: if isAdmin();
    }

    // REMITTANCES
    match /remittances/{id} {
      allow read: if isAdmin()
        || (
          isCashier()
          && resource.data.cashierId == request.auth.uid
        );

      allow create: if isCashier()
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.status == "PENDING ADMIN AUTHORIZATION";

      allow update, delete: if isAdmin();
    }

    // AUDIT LOGS
    match /audit_logs/{id} {
      allow read: if isAdmin()
        || (
          isCashier()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          isCashier()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == "cashier"
        );

      allow update, delete: if isAdmin();
    }
  }
}
