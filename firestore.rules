rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin authorization must follow the same role-based source of truth
    // used by the Admin portal. Do not hard-code a Firebase UID here.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }

    function isClientUnit(data) {
      return isSignedIn()
        && (
          (data.authUserId != null && data.authUserId == request.auth.uid)
          || (data.email != null
              && data.email != ""
              && data.email == request.auth.token.email)
        );
    }

    function isOwnUnitDocument(unitId) {
      return exists(/databases/$(database)/documents/units/$(unitId))
        && isClientUnit(get(/databases/$(database)/documents/units/$(unitId)).data);
    }

    match /users/{uid} {
      // Admin can manage role records; a signed-in user may read only their own role.
      allow read: if isAdmin() || (isSignedIn() && uid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /units/{document} {
      allow read: if isAdmin() || isClientUnit(resource.data);

      // Admin owns all client/unit administration.
      allow create: if isAdmin()
        || (
          request.resource.data.type == "password-reset"
          && request.resource.data.read == false
          && request.resource.data.title == "Customer password reset requested"
          && request.resource.data.clientCode is string
          && request.resource.data.unitCode is string
          && request.resource.data.email is string
          && exists(/databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode))
          && get(/databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)).data.unitCode == request.resource.data.unitCode
          && get(/databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)).data.email == request.resource.data.email
          && get(/databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)).data.active == true
        );

      allow delete: if isAdmin();

      // Clients may update only their own profile fields or establish the UID link.
      allow update: if isAdmin()
        || (
          isClientUnit(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["name", "contact", "address", "authUserId", "forcePasswordChange", "passwordChangedAt", "updatedAt"])
        );
    }

    match /monthlyRecords/{document} {
      allow read: if isAdmin() || isOwnUnitDocument(resource.data.unitId);
      allow write: if isAdmin();
    }

    match /payments/{document} {
      allow read: if isAdmin() || isOwnUnitDocument(resource.data.unitId);
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }

    match /customerLoginDirectory/{clientCode} {
      // Public read is intentionally disabled. This directory is only used by security rules
      // to verify a password-reset request. Admin is the only writer.
      allow read, write: if isAdmin();
    }

    match /passwordResetRequests/{requestId} {
      // Customer can submit a recovery request only when the supplied Client ID, Unit ID
      // and registered email exactly match the Admin-created directory record.
      allow create: if
        request.resource.data.status == "pending"
        && request.resource.data.clientCode is string
        && request.resource.data.unitCode is string
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode))
        && get(/databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)).data.unitCode == request.resource.data.unitCode
        && get(/databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)).data.email == request.resource.data.email
        && get(/databases/$(database)/documents/customerLoginDirectory/$(request.resource.data.clientCode)).data.active == true;

      allow read, update, delete: if isAdmin();
    }

    match /notifications/{document} {
      allow read: if isAdmin() || (
        resource.data.relatedId != null
        && isOwnUnitDocument(resource.data.relatedId)
      );

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          resource.data.relatedId != null
          && isOwnUnitDocument(resource.data.relatedId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        );
    }

    match /supportChats/{chatId} {
      allow read: if isAdmin()
        || (isSignedIn() && chatId == request.auth.uid);

      allow create: if isAdmin()
        || (isSignedIn()
          && chatId == request.auth.uid
          && request.resource.data.authUserId == request.auth.uid
          && request.resource.data.status is string
          && request.resource.data.messages is list);

      allow update: if isAdmin()
        || (isSignedIn()
          && chatId == request.auth.uid
          && resource.data.authUserId == request.auth.uid
          && request.resource.data.authUserId == resource.data.authUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "messages", "updatedAt", "typingBy", "unreadForAdmin", "unreadForCustomer", "status"
          ]));

      allow delete: if isAdmin();
    } {
      // Support conversations are private to the authenticated customer who owns
      // the conversation, or to an authenticated Admin. Do not make chat access
      // depend on the customer's unit linkage fields; those fields can legitimately
      // change while the support conversation must remain available.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.authUserId == request.auth.uid);

      allow create: if isAdmin()
        || (isSignedIn()
          && request.resource.data.authUserId == request.auth.uid
          && request.resource.data.status is string
          && request.resource.data.messages is list);

      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.authUserId == request.auth.uid
          && request.resource.data.authUserId == resource.data.authUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "messages", "updatedAt", "typingBy", "unreadForAdmin", "unreadForCustomer", "status"
          ]));

      allow delete: if isAdmin();
    }

    match /activities/{document} {
      allow read, write: if isAdmin();
    }
  }
}
